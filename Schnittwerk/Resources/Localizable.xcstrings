          }
        }
      }
    },
    "The image has see-through parts. Transparency usually works best for logos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild hat durchsichtige Stellen. Für Logos klappt „Transparenz“ meist am besten."
